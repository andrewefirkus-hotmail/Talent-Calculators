@* One talent tree: header, grid of talents with prerequisite arrows, and reset button.
   Sizes and positions come from Styles/_variables.scss; this file only passes rows and columns. *@

<div class="tree">
    <div class="tree-header">
        <div class="tree-icon" style="@HeaderIconStyle">@(string.IsNullOrEmpty(Tree.Icon) ? Tree.Name[..1] : "")</div>
        <span class="tree-name">@Tree.Name</span>
        <span class="tree-points">@Build.PointsIn(Tree) / @Build.Class.TotalPoints</span>
    </div>

    <div class="tree-grid" style="--rows:@Rows; background:@(Tree.Background ?? "#1b1b1b");">
        @foreach (var talent in Tree.Talents)
        {
            var pre = Build.PrerequisiteOf(talent);
            if (pre is null)
            {
                continue;
            }
            var on = Build.IsPrerequisiteMet(talent) ? "on" : "";
            var position = $"--from-row:{pre.Row}; --from-col:{pre.Col}; --to-row:{talent.Row}; --to-col:{talent.Col};";

            if (pre.Col == talent.Col)
            {
                <div class="arrow down @on" style="@position"></div>
            }
            else if (pre.Row == talent.Row)
            {
                <div class="arrow @(talent.Col > pre.Col ? "right" : "left") @on" style="@position"></div>
            }
            else
            {
                <div class="arrow @(talent.Col > pre.Col ? "across-right" : "across-left") @on" style="@position"></div>
                <div class="arrow down corner @on" style="@position"></div>
            }
        }

        @foreach (var talent in Tree.Talents)
        {
            <TalentNode Talent="talent" Tree="Tree" Build="Build" />
        }
    </div>

    <button class="button tree-reset" @onclick="() => Build.Reset(Tree)" disabled="@(Build.PointsIn(Tree) == 0)">
        <span class="x">✕</span> Reset
    </button>
</div>
