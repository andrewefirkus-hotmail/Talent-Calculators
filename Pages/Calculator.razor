@page "/"
@page "/{ClassSlug}"

<PageTitle>@(Data?.Name ?? "Talent") Talent Calculator</PageTitle>

<div class="calculator">
    <header class="calc-header">
        <h1>
            <span style="color:@(Data?.Color ?? "inherit")">@(Data?.Name ?? "…")</span> Talent Calculator
        </h1>
        @if (Classes.Count > 1)
        {
            <nav class="class-picker">
                @foreach (var classEntry in Classes)
                {
                    <a href="@classEntry.Slug" class="@(classEntry.Slug == Slug ? "active" : "")">@classEntry.Name</a>
                }
            </nav>
        }
    </header>

    @if (Error is not null)
    {
        <p class="error">@Error</p>
    }
    else if (Build is null)
    {
        <p>Loading talents…</p>
    }
    else
    {
        <div class="summary">
            <div><span class="label">Points spent</span> <b>@Build.PointsSpent</b> / @Build.Class.TotalPoints</div>
            <div><span class="label">Remaining</span> <b>@Build.PointsRemaining</b></div>
            <div><span class="label">Required level</span> <b>@(Build.RequiredLevel == 0 ? "–" : Build.RequiredLevel)</b></div>
            <div class="split">@string.Join(" / ", Build.Class.Trees.Select(Build.PointsIn))</div>
            <button class="button reset-all" @onclick="Build.ResetAll" disabled="@(Build.PointsSpent == 0)">Reset all</button>
        </div>

        <div class="trees">
            @foreach (var tree in Build.Class.Trees)
            {
                <TalentTree Tree="tree" Build="Build" />
            }
        </div>

        <p class="help">
            Click a talent to add a point. Right-click or shift-click to remove one.
            The address bar keeps your build, so you can bookmark or share it.
        </p>
    }
</div>
