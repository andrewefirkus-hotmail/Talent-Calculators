@* One talent icon with its rank badge and hover tooltip. *@

<div class="talent @StateClass"
     style="--row:@Talent.Row; --col:@Talent.Col;"
     @onclick="OnClick"
     @oncontextmenu="() => Build.Remove(Talent)"
     @oncontextmenu:preventDefault="true">

    <div class="talent-icon" style="@IconStyle">
        @if (string.IsNullOrEmpty(Talent.Icon))
        {
            <span class="talent-initials">@Initials</span>
        }
    </div>
    <span class="talent-rank">@Rank/@Talent.MaxRank</span>

    <div class="tooltip @(Talent.Col >= 2 ? "tooltip-left" : "tooltip-right")">
        <div class="tooltip-name">@Talent.Name</div>
        <div class="tooltip-rank">Rank @Rank/@Talent.MaxRank</div>

        @if (!Build.IsRowUnlocked(Talent))
        {
            <div class="tooltip-req">Requires @Build.PointsNeededForRow(Talent.Row) points in @Tree.Name Talents</div>
        }
        @if (!Build.IsPrerequisiteMet(Talent))
        {
            var pre = Build.PrerequisiteOf(Talent)!;
            var needed = Build.RequiredPrerequisiteRank(Talent);
            <div class="tooltip-req">Requires @needed @(needed == 1 ? "point" : "points") in @pre.Name</div>
        }

        <div class="tooltip-desc">@TalentBuild.DescribeRank(Talent, Math.Max(Rank, 1))</div>

        @if (Rank > 0 && Rank < Talent.MaxRank)
        {
            <div class="tooltip-next">Next rank:</div>
            <div class="tooltip-desc">@TalentBuild.DescribeRank(Talent, Rank + 1)</div>
        }

        @if (Build.CanAdd(Talent))
        {
            <div class="tooltip-hint learn">Click to learn</div>
        }
        @if (Build.CanRemove(Talent))
        {
            <div class="tooltip-hint unlearn">Right-click (or shift-click) to unlearn</div>
        }
    </div>
</div>
